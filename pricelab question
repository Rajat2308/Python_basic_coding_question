def find(arr):
    r =[]
    peak = arr[0]
    index = 0
    
    for i in range(1,len(arr)):
        if arr[i]* arr[i-1]>0:
            if peak < 0 and arr[i]<peak:
                peak=arr[i]
                index = i
            elif peak>=0 and arr[i]>peak:
                peak = arr[i]
                index = i
        else:
            r.append([index,peak])
            peak = arr[i]
            index = i
    # added this line for bug solve
    r.append([index,peak])        
    return r        

arr =[1,4,2,-2,-9,10,2,12,2,-4,-4,-4,-4,2,6,7]
print(find(arr))

